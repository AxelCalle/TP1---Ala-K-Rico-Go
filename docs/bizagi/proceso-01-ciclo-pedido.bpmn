        <di:waypoint x="1505" y="635"/>
        <di:waypoint x="1460" y="635"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13">
        <di:waypoint x="1740" y="295"/>
        <di:waypoint x="1802" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14">
        <di:waypoint x="1520" y="635"/>
        <di:waypoint x="1680" y="635"/>
        <di:waypoint x="1680" y="505"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F15_di" bpmnElement="F15">
        <di:waypoint x="1680" y="425"/>
        <di:waypoint x="1680" y="295"/>
        <di:waypoint x="1790" y="295"/>
      </bpmndi:BPMNEdge>
