# Copia este archivo como .env y completa con tus credenciales reales

# SQL Server
DB_SERVER=NOMBRE_PC\INSTANCIA_SQLSERVER
DB_PORT=1433
DB_DATABASE=ALAKRICO_GO_DB
DB_USER=sa
DB_PASSWORD=TU_PASSWORD

# JWT
JWT_SECRET=REEMPLAZAR_CON_SECRET_ALEATORIO_256_BITS

# Servidor Express
PORT=3001
FRONTEND_URL=http://localhost:8081

# Fechas del piloto para la comparativa FIFO vs ACO (AAAA-MM-DD; PILOTO_FIN es exclusivo)
PILOTO_INICIO_FIFO=2026-06-01
PILOTO_INICIO_ACO=2026-06-26
PILOTO_FIN=2026-07-07
